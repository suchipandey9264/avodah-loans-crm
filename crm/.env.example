# Copy to .env.production (or set in your host's build settings).
# API origin when the CRM and the backend are deployed separately. Leave empty when /api is on the same origin.
VITE_API_URL=https://api.example.com
# Public website origin, for lender logos (/bank-logos/...). Leave empty when the site and the CRM share an origin.
VITE_SITE_URL=https://www.example.com
