# Copy to .env and adjust.
PORT=4000
# Comma-separated list of origins allowed to call the API (the CRM's address in production).
CORS_ORIGIN=http://localhost:5174
# PostgreSQL connection string (Neon, Supabase, Render, or local). Hosted databases need ?sslmode=verify-full.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=verify-full

# Set to 1 when running behind one proxy/load balancer (Render, Nginx) so rate limits use the visitor's IP.
TRUST_PROXY=0

# --- CRM (staff portal in ../crm) ---
# Where the CRM is served; used to build password-reset and invite links. In production, also add it to CORS_ORIGIN.
CRM_URL=http://localhost:5174
# A staff session ends after this many idle minutes, and after this many hours in total.
CRM_IDLE_MINUTES=60
CRM_SESSION_HOURS=12
# Clock used for the dashboard's day / week / month buckets.
CRM_TIMEZONE=Asia/Kolkata
# Set NODE_ENV=production in production: reset links are never written to the console
# (wire an email provider in src/lib/mailer.js).
# NODE_ENV=production
