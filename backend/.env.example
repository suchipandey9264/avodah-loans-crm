# Copy to .env and adjust.
PORT=4000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# true = accept any 6-digit OTP and return it in the response (demo only). Always off when NODE_ENV=production.
OTP_DEMO=true
# PostgreSQL connection string (Neon, Supabase, Render, or local). Hosted databases need ?sslmode=require.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require

# Cloudflare Turnstile captcha (https://dash.cloudflare.com → Turnstile). Leave empty to turn captcha off.
# The value below is Cloudflare's TEST secret: every check passes. Use your real secret in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Set to 1 when running behind one proxy/load balancer (Render, Nginx) so rate limits use the visitor's IP.
TRUST_PROXY=0

# --- CRM (staff portal in ../crm) ---
# Where the CRM is served; used to build password-reset and invite links. In production, also add it to CORS_ORIGIN.
CRM_URL=http://localhost:5174
# A staff session ends after this many idle minutes, and after this many hours in total.
CRM_IDLE_MINUTES=60
CRM_SESSION_HOURS=12
# Clock used for the dashboard's day / week / month buckets.
CRM_TIMEZONE=Asia/Kolkata
# Set NODE_ENV=production in production: demo OTP is forced off and reset links are never written to the console
# (wire an email provider in src/lib/mailer.js).
# NODE_ENV=production
